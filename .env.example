# ---------------------------------------------------------------------------
# Site
# ---------------------------------------------------------------------------
# Canonical production origin. Used for metadata, Open Graph, sitemap, robots.
NEXT_PUBLIC_SITE_URL=https://www.abdulelah.de

# ---------------------------------------------------------------------------
# AI agent (DeepSeek)
# ---------------------------------------------------------------------------
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-v4-flash

# ---------------------------------------------------------------------------
# Contact email (Resend)
# ---------------------------------------------------------------------------
RESEND_API_KEY=
CONTACT_TO_EMAIL=me@abdulelah.de
CONTACT_FROM_EMAIL=Portfolio Contact <onboarding@resend.dev>

# ---------------------------------------------------------------------------
# Shared rate limiting (Upstash Redis, REST API)
# ---------------------------------------------------------------------------
# Required in production: without these the limiter degrades to per-instance
# counters, which Vercel's serverless fan-out makes close to useless.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# Random string. Salts the hashed client identifier so no raw visitor IP and no
# brute-forceable IP hash is stored. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
RATE_LIMIT_SALT=

# ---------------------------------------------------------------------------
# Bot protection (Cloudflare Turnstile)
# ---------------------------------------------------------------------------
# Site key is public by design and is inlined into the browser bundle.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
# Secret key is server-only. Never expose it with a NEXT_PUBLIC_ prefix.
# When it is empty, Turnstile verification is skipped and the contact form and
# agent fall back to honeypot plus rate limiting.
TURNSTILE_SECRET_KEY=

# ---------------------------------------------------------------------------
# Private Dal Professional Accelerator profile
# ---------------------------------------------------------------------------
# Required for the page to be reachable at all: it fails closed when unset.
# Signs the expiring access link. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Mint a link with: npm run dal:link -- --days 14
DAL_ACCESS_SECRET=

# ---------------------------------------------------------------------------
# Developer diagnostics
# ---------------------------------------------------------------------------
# /api/agent/diagnose returns 404 in production unless this is set and sent as
# `Authorization: Bearer <token>`. Leave empty to keep it disabled in production.
AGENT_DIAGNOSE_TOKEN=
